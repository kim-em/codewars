# Pinned versions for the codewars Lean 4 runner.
# Sourced by scripts/prepare-runner.sh and all install-*.sh scripts.

# --- Lean toolchain ---
# Tracks lean-toolchain (canonical) — duplicated here so shell scripts
# don't have to parse the elan format.
LEAN_VERSION="v4.30.0"

# --- Comparator (https://github.com/leanprover/comparator) ---
# v4.30.0 tag commit, resolved 2026-05-27.
COMPARATOR_REPO="https://github.com/leanprover/comparator"
COMPARATOR_SHA="1cfc5d8ad183bf65efe7accd0efc175b6b8f25b6"

# --- lean4export (https://github.com/leanprover/lean4export) ---
# v4.30.0 tag commit, resolved 2026-05-27.
LEAN4EXPORT_REPO="https://github.com/leanprover/lean4export"
LEAN4EXPORT_SHA="a3e35a584f59b390667db7269cd37fca8575e4bf"

# --- mathlib4 (https://github.com/leanprover-community/mathlib4) ---
# v4.30.0 tag commit, resolved 2026-05-27. Used only by the mathlib
# image variant; the slim variant has no mathlib dependency.
MATHLIB_REPO="https://github.com/leanprover-community/mathlib4"
MATHLIB_SHA="c5ea00351c28e24afc9f0f84379aa41082b1188f"

# Path inside the runner image where mathlib lives. Workspaces
# require mathlib via a path-dep to this location so submissions
# don't need network access.
: "${CODEWARS_MATHLIB_DIR:=/opt/codewars/mathlib}"

# --- landrun (https://github.com/Zouuup/landrun) ---
# Pinned to a main-branch commit, NOT a tagged release. Tagged releases
# through v0.1.15 are missing flags comparator needs (--ldd, --add-exec).
# Mirrors lean-eval's choice; see EvalTools/CheckComparatorInstallation.lean
# in lean-eval for the flag-probe rationale.
LANDRUN_REPO="https://github.com/Zouuup/landrun"
LANDRUN_SHA="5ed4a3db3a4ad930d577215c6b9abaa19df7f99f"

# --- Install layout (inside the runner image / dev environment) ---
# Override these to relocate; defaults match the Dockerfile.
: "${CODEWARS_PREFIX:=/opt/codewars}"
: "${CODEWARS_TOOLS_DIR:=${CODEWARS_PREFIX}/tools}"
: "${CODEWARS_BIN_DIR:=${CODEWARS_PREFIX}/bin}"
